{% extends 'layout/app.html.twig' %}

{% block content %}

<h2 class="mb-4">Dashboard</h2>

<div class="row">

    <div class="col-md-3">
        <div class="card p-3 text-center">
            <h5>Élèves</h5>
            <h2>{{ totalStudents }}</h2>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card p-3 text-center">
            <h5>Enseignants</h5>
            <h2>{{ totalTeachers }}</h2>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card p-3 text-center">
            <h5>Classes</h5>
            <h2>{{ totalClasses }}</h2>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card p-3 text-center">
            <h5>Année</h5>
            <h6>{{ schoolYear }}</h6>
        </div>
    </div>

</div>

{% endblock %}
